      "updated": 1777891419399,
      "link": null,
      "locked": false,
      "text": "ans = 0\n\nfor(j = 0; j < K; j++)\n{\n    sum = 0\n\n    for(i = 0; i < N; i++)\n    {\n        if(checkBit(A[i], j) == 1)\n        {\n            sum++\n        }\n    }\n    \n    if(sum % 3 != 0)\n    {\n        ans = setBit(ans, j);\n    }\n}\n\nreturn ans",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ans = 0\n\nfor(j = 0; j < K; j++)\n{\n    sum = 0\n\n    for(i = 0; i < N; i++)\n    {\n        if(checkBit(A[i], j) == 1)\n        {\n            sum++\n        }\n    }\n    \n    if(sum % 3 != 0)\n    {\n        ans = setBit(ans, j);\n    }\n}\n\nreturn ans",
      "autoResize": true,
      "lineHeight": 1.25
    },
