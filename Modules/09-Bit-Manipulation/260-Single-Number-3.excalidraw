    {
      "id": "st9Wy046Vg86zpSyxRowW",
      "type": "text",
      "x": -338.0491286814795,
      "y": 831.7212901455441,
      "width": 499.65966796875,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "q9kn6b8b_CKpugtLgG2Vo"
      ],
      "frameId": null,
      "index": "b2k",
      "roundness": null,
      "seed": 248625609,
      "version": 584,
      "versionNonce": 1438246820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778067556787,
      "link": null,
      "locked": false,
      "text": "\nxor_arr = 0\nfor (int x : A)\n{\n     xor_arr  ^= x;\n}\n\n// figure out any position in which they both differ\n// => position of any set bit in xor_arr\n\nint pos = -1;\nfor(i = 0; i < K; i++)\n{\n    if(checkBit(xor_arr, i) == 1)\n    {\n        pos = i;\n        break;\n    }\n}\n\n// xor of groups seperately\n\ngroup1 = 0\ngroup2 = 0\n\nfor (int x : A)\n{\n     if(checkBit(x, pos) == 1)\n    {\n        group1 ^= x;\n    }\n    else\n    {\n        group2 ^= x;\n    }\n}\n\nprint(group1, group2)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nxor_arr = 0\nfor (int x : A)\n{\n     xor_arr  ^= x;\n}\n\n// figure out any position in which they both differ\n// => position of any set bit in xor_arr\n\nint pos = -1;\nfor(i = 0; i < K; i++)\n{\n    if(checkBit(xor_arr, i) == 1)\n    {\n        pos = i;\n        break;\n    }\n}\n\n// xor of groups seperately\n\ngroup1 = 0\ngroup2 = 0\n\nfor (int x : A)\n{\n     if(checkBit(x, pos) == 1)\n    {\n        group1 ^= x;\n    }\n    else\n    {\n        group2 ^= x;\n    }\n}\n\nprint(group1, group2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
