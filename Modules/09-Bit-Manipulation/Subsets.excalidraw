      "updated": 1777978337907,
      "link": null,
      "locked": false,
      "text": "\n\nfor(mask = 0; mask < (1 << N); mask++)\n{\n    for(i = 0; i < N; i++)\n    {\n            if(checkBit(mask, i) == 1)\n            {\n                cout << A[i] << \" \";\n            }\n    }\n    cout << endl;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nfor(mask = 0; mask < (1 << N); mask++)\n{\n    for(i = 0; i < N; i++)\n    {\n            if(checkBit(mask, i) == 1)\n            {\n                cout << A[i] << \" \";\n            }\n    }\n    cout << endl;\n}",
      "autoResize": true,
      "lineHeight": 1.25
